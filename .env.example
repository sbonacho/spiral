# Copia este fichero a .env y rellena lo que vayas a usar:  cp .env.example .env
# .env está en .gitignore: nunca lo subas ni lo pegues en un chat.
# Las claves vacías se ignoran. Pasos para conseguir cada una: README.md, sección 4.

# --- Carpeta de grabaciones (siempre la misma) -------------------------------
# Aquí van los .mov de OBS (y opcionalmente intro.mov / outro.mov).
# Los resultados quedan en SOURCE_DIR/out/<episodio>/
SOURCE_DIR=~/Movies

# Carpeta de archivo. "Archivar" mueve aquí cada episodio procesado, en una carpeta con su
# nombre que contiene el .mov original y todo su resultado (mp3, clips, transcripción...).
ARCHIVE_DIR=~/Movies/archivo

# --- Archive.org (aloja los mp3) — README 4.2 --------------------------------
# https://archive.org/account/s3.php  (si las dejas vacías, se usa 'ia configure')
IA_ACCESS_KEY=
IA_SECRET_KEY=

# --- Bluesky — README 4.5 ----------------------------------------------------
BLUESKY_HANDLE=tuusuario.bsky.social
BLUESKY_APP_PASSWORD=

# --- Mastodon — README 4.6 ---------------------------------------------------
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=

# --- Instagram (Reels) — README 4.7 ------------------------------------------
# Token de larga duración (60 días). El script lo renueva solo en cada uso.
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=

# --- YouTube — README 4.4 ----------------------------------------------------
# No usa claves aquí: guarda el OAuth descargado de Google Cloud en
#   ~/.config/callespiral/client_secret.json
# La primera vez se abre el navegador para autorizar.

# --- X (Twitter) y TikTok — README 4.9 ---------------------------------------
# Sin claves: X se publica con enlaces que abres tú; TikTok es manual.
