# Copy to .env in the directory where you run `spiral`:  cp .env.example .env
# This file overrides ~/.config/spiral/.env variable by variable. Empty values are ignored.
# Put comments on their own line: text after a value on the same line becomes part of the value.
# .env is git-ignored: never commit it or paste it in a chat. See README for how to get each key.

# --- Where results go (relative to this directory; default shown) ---------------------------
# PROCESSED_DIR=processed
# PUBLISHED_DIR=published

# --- Your show (needed to publish the audio, blog and RSS feed) -------------------------------
PODCAST_TITLE=
PODCAST_DESCRIPTION=
PODCAST_AUTHOR=
PODCAST_EMAIL=
PODCAST_CATEGORY=Society & Culture
# Language of the transcript and texts, and of spiral's own messages (es or en; others use English)
PODCAST_LANGUAGE=en
# PODCAST_IMAGE=https://<user>.github.io/<repo>/cover.jpg
SITE_URL=https://<user>.github.io/<repo>

# --- Summary provider: claude | gemini | ollama ---------------------------------------------
# LLM_PROVIDER=claude
# CLAUDE_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# OLLAMA_MODEL=
# OLLAMA_URL=http://localhost:11434

# --- Audio hosting (Archive.org keys: https://archive.org/account/s3.php) -----------------------
# IA_ACCESS_KEY=
# IA_SECRET_KEY=

# --- Accounts. For each network: <NETWORK>_ACCOUNTS=a,b and <NETWORK>_<ACCOUNT>_<FIELD> ---------
# Bluesky (app password: Settings > Privacy and security > App passwords)
# BLUESKY_ACCOUNTS=show,personal
# BLUESKY_SHOW_HANDLE=myshow.bsky.social
# BLUESKY_SHOW_APP_PASSWORD=
# BLUESKY_PERSONAL_HANDLE=
# BLUESKY_PERSONAL_APP_PASSWORD=

# Mastodon (Preferences > Development > New application, scope write:statuses)
# MASTODON_ACCOUNTS=show
# MASTODON_SHOW_URL=https://mastodon.social
# MASTODON_SHOW_TOKEN=

# Instagram Reels (professional account + Meta app with Instagram Login). The token is renewed
# automatically and stored in ~/.config/spiral/tokens/.
# INSTAGRAM_ACCOUNTS=show
# INSTAGRAM_SHOW_USER_ID=
# INSTAGRAM_SHOW_TOKEN=

# YouTube: OAuth client JSON from Google Cloud (Desktop app). Default path shown.
# YOUTUBE_ACCOUNTS=channel
# YOUTUBE_CHANNEL_CLIENT_SECRET=~/.config/spiral/client_secret.json

# X and TikTok have no automatic posting: spiral prepares the content and asks you to confirm.
# X_ACCOUNTS=show
# TIKTOK_ACCOUNTS=show
