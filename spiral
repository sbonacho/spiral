#!/usr/bin/env python3
"""spiral: asistente para procesar, publicar y archivar los episodios del programa.

  spiral             menú guiado (muestra qué redes tienes configuradas y cuáles no)
  spiral list        ficheros disponibles, marcando los procesados
  spiral process     buscar un fichero y procesarlo
  spiral publish     buscar un fichero y elegir en qué redes publicarlo
  spiral archive     mover a ARCHIVE_DIR todos los procesados
  spiral view        informe HTML de todos los ficheros

Las carpetas y las claves salen de .env (ver .env.example). El trabajo lo hace engine.py.
"""
import os
import shutil
import subprocess
import sys
from pathlib import Path

import library
import social

ROOT = Path(__file__).resolve().parent
ENGINE = ROOT / "engine.py"
REPORT = ROOT / "informe.html"
SITE_CONFIG = ROOT / "site" / "podcast.json"


def ask(prompt):
    """input() que devuelve '' con Enter y sale limpio con Ctrl-D."""
    try:
        return input(prompt).strip()
    except EOFError:
        print()
        sys.exit(0)


def confirm(prompt, default=False):
    ans = ask(f"{prompt} [{'S/n' if default else 's/N'}] ").lower()
    return default if not ans else ans in ("s", "si", "sí", "y", "yes")


def parse_selection(text, n):
    """'1,3,5-7' -> [0, 2, 4, 5, 6]; None si no es válido."""
    picked = set()
    try:
        for part in text.replace(" ", "").split(","):
            a, _, b = part.partition("-")
            lo, hi = int(a), int(b or a)
            if not 1 <= lo <= hi <= n:
                return None
            picked.update(range(lo - 1, hi))
    except ValueError:
        return None
    return sorted(picked)


def engine(*args):
    """Ejecuta engine.py mostrando su salida; True si terminó bien."""
    ok = subprocess.run([str(ENGINE), *args]).returncode == 0
    if not ok:
        print("  ✘ Falló (mira el mensaje de arriba).")
    return ok


# ---------------------------------------------------------------- redes configuradas

def networks():
    """Cada destino con lo que le falta para poder usarse (lista vacía = configurado)."""
    def env(*keys):
        return all(os.environ.get(k) for k in keys)

    site = SITE_CONFIG.exists() and "TU_USUARIO" not in SITE_CONFIG.read_text()
    ia = env("IA_ACCESS_KEY", "IA_SECRET_KEY") or any(
        p.exists() for p in (Path.home() / ".config/internetarchive/ia.ini", Path.home() / ".ia"))
    instagram = env("INSTAGRAM_USER_ID") and (
        env("INSTAGRAM_TOKEN") or (social.CONFIG_DIR / "instagram_token").exists())
    specs = (
        ("audio", "Audio + blog + RSS", [(ia, "claves de Archive.org")], "README 4.2"),
        ("youtube", "YouTube (episodio y Shorts)",
         [((social.CONFIG_DIR / "client_secret.json").exists(), "client_secret.json")], "README 4.4"),
        ("bluesky", "Bluesky", [(env("BLUESKY_HANDLE", "BLUESKY_APP_PASSWORD"), "BLUESKY_* en .env")], "README 4.5"),
        ("mastodon", "Mastodon", [(env("MASTODON_URL", "MASTODON_TOKEN"), "MASTODON_* en .env")], "README 4.6"),
        ("instagram", "Instagram (Reels)", [(instagram, "INSTAGRAM_* en .env")], "README 4.7"),
        ("x", "X (te dejo los enlaces, publicas tú)", [], "README 4.9"),
        ("tiktok", "TikTok (subida a mano)", [], "README 4.9"),
    )
    needs_site = {"audio", "youtube", "bluesky", "mastodon", "instagram", "x"}
    out = []
    for key, label, checks, readme in specs:
        if key in needs_site:
            checks = checks + [(site, "site/podcast.json")]
        out.append({"key": key, "label": label, "readme": readme,
                    "missing": [what for ok, what in checks if not ok]})
    return out


def show_networks(nets):
    print("\nRedes")
    for n in nets:
        if n["missing"]:
            print(f"  ✘ {n['label']} — falta: {', '.join(n['missing'])} ({n['readme']})")
        else:
            print(f"  ✔ {n['label']}")


# ---------------------------------------------------------------- listados y búsqueda

def mark(src, stem):
    return "x" if library.is_processed(src, stem) else " "


def describe(src, stem):
    out = src / "out" / stem
    title = library.title(out) if library.is_processed(src, stem) else ""
    pub = library.done(library.read_state(out))
    return f"[{mark(src, stem)}] {stem}" + (f" — {title}" if title else "") + (f"  → {', '.join(pub)}" if pub else "")


def do_list(src, archive):
    eps = library.episodes(src)
    print(f"\nCarpeta: {src}")
    print(f"  intro: {'sí' if (src / 'intro.mov').exists() else 'no'} | "
          f"outro: {'sí' if (src / 'outro.mov').exists() else 'no'}\n")
    if not eps:
        print("  (no hay .mov)")
    for i, stem in enumerate(eps, 1):
        size = (src / f"{stem}.mov").stat().st_size / 1e6
        print(f"  {i:>2}. {describe(src, stem)}  ({size:.0f} MB)")
    archived = len(library.collect(src, archive)) - len(eps) if archive.is_dir() else 0
    print("\n  [x] = procesado" + (f" · {archived} archivado(s): `spiral view`" if archived else ""))


def pick_one(src, only_processed=False):
    """Muestra todos los ficheros; se elige por número o se escribe texto para buscar."""
    eps = library.episodes(src)
    if not eps:
        print(f"\nNo hay .mov en {src}")
        return None
    shown = eps
    while True:
        print()
        for i, stem in enumerate(shown, 1):
            print(f"  {i:>2}. {describe(src, stem)}")
        text = ask("\nNúmero, o texto para buscar ('*' = ver todos, Enter = volver): ")
        if not text:
            return None
        if text == "*":
            shown = eps
        elif text.isdigit() and 1 <= int(text) <= len(shown):
            stem = shown[int(text) - 1]
            if only_processed and not library.is_processed(src, stem):
                print("  Ese fichero aún no está procesado: usa `spiral process`.")
                continue
            return stem
        else:
            q = text.lower()
            found = [s for s in eps if q in describe(src, s).lower()]
            if found:
                shown = found
            else:
                print(f"  Sin resultados para '{text}'.")


# ---------------------------------------------------------------- acciones

def do_process(src, archive):
    stem = pick_one(src)
    if not stem:
        return
    redo = library.is_processed(src, stem)
    if redo:
        print(f"\n{stem} ya está procesado. Rehacerlo borra la transcripción, contenido.json")
        print("(también tus ediciones) y los clips; se conserva el registro de lo ya publicado.")
        if not confirm("¿Rehacerlo?"):
            return
    engine("process", str(src), "--episodio", stem, *(["--rehacer"] if redo else []))


def do_publish(src, archive):
    stem = pick_one(src, only_processed=True)
    if not stem:
        return
    out = src / "out" / stem
    state = library.read_state(out)
    nets = networks()
    print(f"\n¿Dónde publicar «{stem}»?\n")
    for i, n in enumerate(nets, 1):
        if n["missing"]:
            print(f"  {i}) ✘ {n['label']} — no configurada (falta: {', '.join(n['missing'])})")
        else:
            print(f"  {i}) ✔ {n['label']}{'  (ya publicado)' if state.get(n['key']) else ''}")
    while True:
        text = ask("\nMarca varias (ej. 1,3), 't' = todas las configuradas, Enter = volver: ").lower()
        if not text:
            return
        idx = list(range(len(nets))) if text == "t" else parse_selection(text, len(nets))
        if idx is not None:
            break
        print("  Selección no válida.")
    chosen = [nets[i] for i in idx if not nets[i]["missing"]]
    if text != "t" and len(chosen) < len(idx):
        print("  Se ignoran las no configuradas: " + ", ".join(nets[i]["label"] for i in idx if nets[i]["missing"]))
    if not chosen:
        print("  No hay ninguna red configurada en la selección.")
        return
    keys = [n["key"] for n in chosen]
    print(f"\nEpisodio: {stem}\nRedes: {', '.join(n['label'] for n in chosen)}")
    action = ask("[s = publicar, d = simular, Enter = cancelar] ").lower()
    if action not in ("s", "d"):
        return
    dry = action == "d"

    if "audio" in keys:
        if dry:
            print("\n(audio + blog + RSS: no tiene simulación, se omite)")
        else:
            push = confirm("\n¿Subir también site/ a GitHub (hace falta para que el RSS se actualice)?", default=True)
            if not engine("publish", str(src), stem, *(["--push"] if push else [])):
                print("  No sigo con las redes: sus textos enlazan al post del blog.")
                return
    api = [k for k in keys if k in ("youtube", "bluesky", "mastodon", "instagram", "x")]
    if api:
        engine("social", str(src), stem, "--only", ",".join(api), *(["--dry-run"] if dry else []))
    if "tiktok" in keys:
        print(f"\nTikTok: sube a mano los clips de {out / 'clips'}")
        if not dry:
            subprocess.run(["open", str(out / "clips")])
    if not dry:
        for k in [k for k in ("x", "tiktok") if k in keys]:
            if confirm(f"¿Ya has publicado en {k}? Lo anoto para el informe"):
                library.set_manual(out, [k], True)


def do_archive(src, archive):
    ready = [s for s in library.episodes(src) if library.is_processed(src, s)]
    if not ready:
        print("\nNo hay episodios procesados que archivar.")
        return
    print(f"\nSe moverán a {archive}/<episodio>/ el .mov original y todo su resultado:\n")
    for s in ready:
        pub = library.done(library.read_state(src / "out" / s))
        print(f"  - {s}  {'→ ' + ', '.join(pub) if pub else '(sin publicar en ningún sitio)'}")
    print("\nDesde el archivo ya no se pueden publicar con `spiral publish`.")
    if confirm("¿Archivar todos?"):
        engine("archive")


def do_view(src, archive):
    if not engine("report", "-o", str(REPORT)):
        return
    if subprocess.run(["open", str(REPORT)]).returncode != 0:
        print(f"  Ábrelo en el navegador: {REPORT}")


def do_config(src, archive):
    show_networks(networks())


ACTIONS = {"list": do_list, "process": do_process, "publish": do_publish,
           "archive": do_archive, "view": do_view, "config": do_config}
HELP = {"list": "ficheros disponibles (marca los procesados)",
        "process": "buscar un fichero y procesarlo",
        "publish": "elegir un fichero y las redes donde publicarlo",
        "archive": "mover a archivo todos los procesados",
        "view": "informe HTML de todos los ficheros",
        "config": "qué redes tienes configuradas"}


# ---------------------------------------------------------------- arranque

def first_run():
    """Sin .env no se sabe dónde están los .mov: se crea desde la plantilla."""
    env, example = ROOT / ".env", ROOT / ".env.example"
    print(f"No encuentro {env}.")
    if example.exists() and confirm("¿Lo creo a partir de .env.example?", default=True):
        shutil.copy(example, env)
        env.chmod(0o600)
        print(f"Creado. Edítalo (SOURCE_DIR, ARCHIVE_DIR y las claves) y vuelve a ejecutar `spiral`:\n  open -e {env}")
    sys.exit(0)


def main():
    if not (ROOT / ".env").exists():
        first_run()
    social.load_env()
    args = sys.argv[1:]
    if args and args[0] not in ACTIONS:
        print(__doc__)
        sys.exit(0 if args[0] in ("-h", "--help", "help") else 2)
    try:
        src, archive = library.source_dir(), library.env_dir("ARCHIVE_DIR")
    except SystemExit as e:
        sys.exit(f"{e.code}\nEdita {ROOT / '.env'}")
    if args:
        ACTIONS[args[0]](src, archive)
        return

    print("\n=== spiral · Calle Spiral ===")
    show_networks(networks())
    names = list(ACTIONS)
    while True:
        print("\nAcciones")
        for i, name in enumerate(names, 1):
            print(f"  {i}) {name:<8} {HELP[name]}")
        print("  0) salir")
        try:
            choice = ask("\n> ").lower()
            if choice in ("0", "q", "salir", "exit"):
                return
            name = names[int(choice) - 1] if choice.isdigit() and 1 <= int(choice) <= len(names) else choice
            if name in ACTIONS:
                ACTIONS[name](src, archive)
            else:
                print("  Opción no válida.")
        except KeyboardInterrupt:
            print("\n  (cancelado, vuelves al menú)")
        except SystemExit as e:  # error recogido de library/engine: se avisa y se sigue
            if e.code in (0, None):
                raise
            print(f"  {e.code}")


if __name__ == "__main__":
    main()
